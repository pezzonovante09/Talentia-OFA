# ================================================================
# talentia-ai-proxy-next — переменные окружения
# ================================================================
# Этот файл — шаблон. Скопируй его в .env.local для локальной
# разработки. Для продакшена добавь значения в Vercel Dashboard:
# Project → Settings → Environment Variables
# ================================================================

# ─── DeepSeek AI ─────────────────────────────────────────────────
# Используется в /api/tali (чат-помощник Tali)
# Получить ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (для будущего расширения бэкенда) ──────────────────
# Если понадобится обращаться к БД из серверных роутов:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# ─── CORS (опционально) ──────────────────────────────────────────
# ALLOWED_ORIGIN=https://your-domain.com
