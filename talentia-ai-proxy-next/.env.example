# Copy to .env.local and fill in.

DEEPSEEK_API_KEY=

# Supabase — required to verify user JWTs on /api/tali, /api/tts, /api/report*
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key — /api/account/delete acts as the user (RLS) for transfers
SUPABASE_ANON_KEY=

# Optional: when set, ONLY /api/ping requires header X-Talentia-Secret.
# Tali / TTS / report routes use Supabase JWT, not this secret.
TALENTIA_API_SECRET=

# Comma-separated browser origins for CORS (native apps omit Origin).
# CORS is applied in src/lib/cors-strict.ts — do not set wildcard ACAO in vercel.json.
ALLOWED_CORS_ORIGINS=

# Upstash Redis — required in production (fail-closed 503 if missing).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ElevenLabs TTS (primary)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional multilingual voice for Kyrgyz
ELEVENLABS_VOICE_ID_KY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_TTS_STABILITY=
ELEVENLABS_TTS_SIMILARITY=
ELEVENLABS_TTS_STYLE=

# Hugging Face / TTS fallback (any one of these token names works)
HUGGINGFACE_API_TOKEN=
HF_API_TOKEN=
TTS_KEY=
# engine: elevenlabs | huggingface (see tts/route.ts)
TTS_ENGINE=
TTS_HF_FALLBACK=

# Sentry error monitoring (optional; leave unset to disable - see src/instrumentation.ts)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps / associate releases; skipped otherwise.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
