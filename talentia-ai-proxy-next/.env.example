# Copy to .env.local and fill in.

DEEPSEEK_API_KEY=

# When set, API routes require header: X-Talentia-Secret: <same value>
# Mobile: EXPO_PUBLIC_TALENTIA_API_SECRET
# Leave unset to disable secret checks (local dev only).
TALENTIA_API_SECRET=

# Comma-separated browser origins for CORS (native apps omit Origin).
ALLOWED_CORS_ORIGINS=
