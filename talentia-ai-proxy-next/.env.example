# Copy to .env.local and fill in.
# REQUIRED = the proxy cannot work without it; OPTIONAL = safe to leave empty.
# `src/lib/envExample.test.ts` keeps this file in sync with what the code actually reads.

# ── AI conversation with Tali (/api/v2/tali) ───────────────────────────────────────────
# OFF by default (owner decisions #66, #102: AI is the very last stage). Set to "true" only after
# the provider contract and the lawyer-approved consent text. While off, the route answers 503
# "ai_disabled" before any other check, and the app replies from the on-device phrase bank.
TALI_AI_ENABLED=
# REQUIRED when TALI_AI_ENABLED=true. Provider name/endpoint/model: src/lib/aiConfig.ts.
DEEPSEEK_API_KEY=

# ── Supabase — REQUIRED (verify user JWTs, consent checks, account deletion) ───────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key — routes act as the user (RLS) for consent checks and ownership transfers
SUPABASE_ANON_KEY=

# ── Upstash Redis — REQUIRED in production (fail-closed 503 if missing) ────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Daily caps — OPTIONAL (defaults in src/lib/ratelimit.ts: 200 / 30 / 30000) ─────────
TALI_DAILY_REQUESTS_PER_USER=
TALI_DAILY_REPLIES_PER_CHILD=
TTS_DAILY_CHARS_PER_USER=

# ── Optional: when set, ONLY /api/ping requires header X-Talentia-Secret ───────────────
TALENTIA_API_SECRET=

# Comma-separated browser origins for CORS (native apps omit Origin).
# CORS is applied in src/lib/cors-strict.ts — do not set wildcard ACAO in vercel.json.
ALLOWED_CORS_ORIGINS=

# ── ElevenLabs voice of the filtered Tali reply — OPTIONAL (without it: text only) ─────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional multilingual voice for Kyrgyz
ELEVENLABS_VOICE_ID_KY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_TTS_STABILITY=
ELEVENLABS_TTS_SIMILARITY=
ELEVENLABS_TTS_STYLE=

# ── Sentry error monitoring — OPTIONAL (leave unset to disable; see src/instrumentation.ts) ─
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps / associate releases at build time; skipped otherwise.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
