{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_LEGAL_BASE_URL": "https://YOUR_PROXY_HOST",
        "EXPO_PUBLIC_BACKEND_URL": "https://YOUR_PROXY_HOST"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_LEGAL_BASE_URL": "https://YOUR_PROXY_HOST",
        "EXPO_PUBLIC_BACKEND_URL": "https://YOUR_PROXY_HOST"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
