{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_LEGAL_BASE_URL": "https://talentia-ai-proxy-next.vercel.app",
        "EXPO_PUBLIC_BACKEND_URL": "https://talentia-ai-proxy-next.vercel.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_LEGAL_BASE_URL": "https://talentia-ai-proxy-next.vercel.app",
        "EXPO_PUBLIC_BACKEND_URL": "https://talentia-ai-proxy-next.vercel.app"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
