{
  "_comment": "Keys/patterns where EN and/or KY are expected to be byte-identical to RU — either because the content teaches Russian itself (grammar/phonics/cross-language exercises), or because the KY word is a standard, correct Kyrgyz loanword/proper noun. Used by check-i18n.js's RU-identity check to avoid false positives. Reviewed 2026-08-12 against the actual current locale files — do not add new entries here without checking the value is genuinely not a translation bug.",
  "patterns": [
    { "re": "^data\\.(tasks|topics|lessons|intro|dialog)\\.g[1-4]r", "locales": ["en", "ky"], "why": "Russian-language grammar/reading lessons — content is about Russian, legitimately shown in Russian regardless of interface language" },
    { "re": "^data\\.(tasks|topics|lessons|intro|dialog)\\.forest", "locales": ["en", "ky"], "why": "Grade-1 Russian-alphabet phonics world (forestVowels/forestConsonants/forestSyllables etc.) — same reasoning as g[1-4]r" },
    { "re": "^data\\.tasks\\.nrw_f(vl|conl|syll)", "locales": ["en", "ky"], "why": "Phonics/reading-readiness content teaching Russian-alphabet letter/syllable recognition" },
    { "re": "^data\\.tasks\\.pre_opt_word_(mama|molo|muka)$", "locales": ["en", "ky"], "why": "Russian syllable-reading exercise options, same reasoning as nrw_f*" },
    { "re": "^data\\.tasks\\.g2e_(phrl1_opt|yd_opt)_", "locales": ["en", "ky"], "why": "English-track exercises that test recognition/translation FROM a Russian word (e.g. \"what does Спасибо mean?\") — the Russian word is the content being tested" },
    { "re": "^data\\.npc\\.", "locales": ["en", "ky"], "why": "Character proper names" },
    { "re": "^(common\\.appName|tali\\.(name|assistantName))$", "locales": ["en", "ky"], "why": "Brand/mascot proper names" }
  ],
  "keys": {
