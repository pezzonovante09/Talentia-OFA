# Cloud sync (step 7 of the rebuild). NOT read by the app yet — the Supabase adapter will read these.
# The app works fully on-device without them; the cloud is off until the parent turns it on.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to ship; RLS protects the data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Origin of the proxy (talentia-ai-proxy-next) — account deletion and, last of all, the AI conversation
EXPO_PUBLIC_BACKEND_URL=https://your-backend.com
